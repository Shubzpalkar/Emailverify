{
  "providers": [
    {
      "name": "Microsoft 365",
      "type": "cloud_workspace",
      "mx_patterns": ["protection.outlook.com", "eo.outlook.com", "mail.protection.outlook.com"],
      "banner_patterns": ["microsoft ESMTP", "outlook.com"],
      "rules": {
        "hide_mailbox_existence": true,
        "interpret_temp_fail_as_protected": true,
        "max_concurrent": 10,
        "enum_protection": false
      }
    },
    {
      "name": "Google Workspace",
      "type": "cloud_workspace",
      "mx_patterns": ["google.com", "googlemail.com", "aspmx.l.google.com", "alt1.aspmx.l.google.com"],
      "banner_patterns": ["mx.google.com", "smtp.gmail.com"],
      "rules": {
        "hide_mailbox_existence": false,
        "strict_rcpt_validation": true,
        "max_concurrent": 15,
        "enum_protection": false
      }
    },
    {
      "name": "Proofpoint",
      "type": "gateway",
      "mx_patterns": ["pphosted.com", "proofpoint.com"],
      "banner_patterns": ["proofpoint", "pphosted"],
      "rules": {
        "enum_protection": true,
        "interpret_554_as_protected": true,
        "max_concurrent": 5
      }
    },
    {
      "name": "Mimecast",
      "type": "gateway",
      "mx_patterns": ["mimecast.com", "mimecast.eu"],
      "banner_patterns": ["mimecast"],
      "rules": {
        "enum_protection": true,
        "interpret_550_policy_as_protected": true,
        "max_concurrent": 5
      }
    },
    {
      "name": "Barracuda",
      "type": "gateway",
      "mx_patterns": ["barracudanetworks.com", "barracuda.com", "barracuda"],
      "banner_patterns": ["barracuda"],
      "rules": {
        "throttle_detection": true,
        "max_concurrent": 5
      }
    },
    {
      "name": "Cisco Secure Email",
      "type": "gateway",
      "mx_patterns": ["iphmx.com", "cisco.com"],
      "banner_patterns": ["cisco", "ironport"],
      "rules": {
        "probe_limit_protection": true,
        "max_concurrent": 5
      }
    },
    {
      "name": "Trend Micro",
      "type": "gateway",
      "mx_patterns": ["trendmicro.com", "trendmicro.eu"],
      "banner_patterns": ["trendmicro", "interscan"],
      "rules": {
        "enum_protection": true,
        "max_concurrent": 5
      }
    },
    {
      "name": "Symantec Messaging Gateway",
      "type": "gateway",
      "mx_patterns": ["messagelabs.com", "symantec.com"],
      "banner_patterns": ["messagelabs", "symantec"],
      "rules": {
        "enum_protection": true,
        "max_concurrent": 5
      }
    },
    {
      "name": "Zoho Mail",
      "type": "cloud_workspace",
      "mx_patterns": ["zoho.com", "zoho.eu", "zoho.in"],
      "banner_patterns": ["mx.zoho.com"],
      "rules": {
        "max_concurrent": 8
      }
    },
    {
      "name": "Yahoo Mail",
      "type": "consumer",
      "mx_patterns": ["yahoodns.net", "yahoo.com", "yahoodns"],
      "banner_patterns": ["yahoo.com", "yahoodns"],
      "rules": {
        "max_concurrent": 5
      }
    },
    {
      "name": "Yandex Mail",
      "type": "cloud_workspace",
      "mx_patterns": ["yandex.ru", "yandex.net", "yandex.com"],
      "banner_patterns": ["yandex.ru"],
      "rules": {
        "max_concurrent": 8
      }
    },
    {
      "name": "Fastmail",
      "type": "cloud_workspace",
      "mx_patterns": ["messagingengine.com", "fastmail.com"],
      "banner_patterns": ["messagingengine.com"],
      "rules": {
        "max_concurrent": 8
      }
    },
    {
      "name": "Amazon SES",
      "type": "cloud_workspace",
      "mx_patterns": ["amazonses.com"],
      "banner_patterns": ["amazonses"],
      "rules": {
        "max_concurrent": 10
      }
    },
    {
      "name": "Proton Mail",
      "type": "cloud_workspace",
      "mx_patterns": ["protonmail.ch", "mail.protonmail.pp.mailo.fr"],
      "banner_patterns": ["protonmail"],
      "rules": {
        "enum_protection": true,
        "max_concurrent": 5
      }
    },
    {
      "name": "IceWarp",
      "type": "on_premise",
      "mx_patterns": ["icewarp.com"],
      "banner_patterns": ["icewarp"],
      "rules": {
        "max_concurrent": 5
      }
    },
    {
      "name": "Mailcow",
      "type": "on_premise",
      "mx_patterns": [],
      "banner_patterns": ["mailcow", "postfix-mailcow"],
      "rules": {
        "max_concurrent": 5
      }
    },
    {
      "name": "Postfix",
      "type": "mta",
      "mx_patterns": [],
      "banner_patterns": ["postfix", "220 ESMTP Postfix"],
      "rules": {
        "standard_smtp": true,
        "max_concurrent": 10
      }
    },
    {
      "name": "Exim",
      "type": "mta",
      "mx_patterns": [],
      "banner_patterns": ["exim"],
      "rules": {
        "standard_smtp": true,
        "max_concurrent": 10
      }
    },
    {
      "name": "Sendmail",
      "type": "mta",
      "mx_patterns": [],
      "banner_patterns": ["sendmail"],
      "rules": {
        "standard_smtp": true,
        "max_concurrent": 5
      }
    },
    {
      "name": "Haraka",
      "type": "mta",
      "mx_patterns": [],
      "banner_patterns": ["haraka"],
      "rules": {
        "max_concurrent": 5
      }
    },
    {
      "name": "MailEnable",
      "type": "on_premise",
      "mx_patterns": [],
      "banner_patterns": ["mailenable"],
      "rules": {
        "max_concurrent": 5
      }
    },
    {
      "name": "Qmail",
      "type": "mta",
      "mx_patterns": [],
      "banner_patterns": ["qmail"],
      "rules": {
        "max_concurrent": 5
      }
    }
  ]
}
